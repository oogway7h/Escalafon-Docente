# Token compartido con el backend (IA_SERVICE_TOKEN en backend/.env).
IA_SERVICE_TOKEN=
# Mismas credenciales y bucket que el backend.
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opcionales: trabajos simultáneos (cada uno usa OCR_JOBS procesos de ocrmypdf) y calidad JPEG de la compresión.
MAX_TRABAJOS=1
OCR_JOBS=2
JPEG_QUALITY=75
