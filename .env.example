# Variables del docker-compose (raíz). Copiar a .env.
# Dirección pública del sistema: va en los enlaces de los correos (activación, recuperación, seguimiento).
URL_PUBLICA=http://localhost
# Puerto donde nginx publica la web y la API (80 por defecto).
PUERTO_WEB=80
# "true" solo si hay HTTPS delante (certificado): la cookie de sesión se marca Secure. Con HTTP plano déjalo en false.
COOKIE_SECURE=false
# Origen extra permitido en la CSP para subir documentos (p. ej. MinIO). Vacío = solo S3 de AWS.
CSP_CONNECT_EXTRA=
