APP_ENV=development
APP_PUERTO=8080
APP_URL_FRONTEND=http://localhost:3000
# Direcciones desde las que se acepta X-Forwarded-For (servidor de Next)
PROXIES_CONFIABLES=127.0.0.1,::1

DATABASE_URL=postgresql://USUARIO:CLAVE@HOST-pooler.REGION.aws.neon.tech/BD?sslmode=require
DATABASE_URL_DIRECT=postgresql://USUARIO:CLAVE@HOST.REGION.aws.neon.tech/BD?sslmode=require
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5433/escalafon_test?sslmode=disable

REDIS_URL=redis://localhost:6379/0

JWT_SECRETO=cambiar-por-al-menos-32-bytes-aleatorios
JWT_EMISOR=escalafon-uagrm
SESION_HORAS=8

MAX_INTENTOS_LOGIN=3
MINUTOS_BLOQUEO=15
MINUTOS_TOKEN_RECUPERACION=30
HORAS_TOKEN_ACTIVACION=24

SMTP_HOST=localhost
SMTP_PUERTO=1025
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=no-responder@escalafon.uagrm.edu.bo

# Adjuntos de trámites (S3). Vacío = deshabilitado (subir/descargar adjuntos responde 503).
# S3_ENDPOINT solo se usa con un servicio compatible (MinIO, etc.); vacío = AWS.
# Los nombres antiguos S3_REGION / S3_ACCESS_KEY / S3_SECRET_KEY siguen funcionando como alternativa.
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Servicio de OCR y compresión (ia-service, CU-15). Vacío = los documentos se suben pero no se procesan.
IA_SERVICE_URL=http://localhost:8000
IA_SERVICE_TOKEN=

# Tablero (CU-25): días máximos de préstamo de una carpeta antes de la alerta de mora. Vacío = 15.
DIAS_MAXIMOS_PRESTAMO=15

SEED_DIRECTOR_CORREO=
SEED_DIRECTOR_NOMBRES=
SEED_DIRECTOR_APELLIDOS=

# Reportes en lenguaje natural (opcional). Sin clave el formulario de reportes funciona igual.
GROQ_API_KEY=
GROQ_MODEL=
